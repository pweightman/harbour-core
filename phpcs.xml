<?xml version="1.0"?>
<ruleset name="Harbour Core">
	<description>WordPress-Extra coding standards for harbour-core.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress-Extra">
		<!-- The plugin uses a flat function API, not classes, by design. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Files.OneObjectStructurePerFile"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="harbour-core"/></property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>
</ruleset>
